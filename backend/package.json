{\n  "name": "kayisihub-backend",\n  "version": "0.1.0",\n  "description": "KayisiHub Gaming Marketplace Backend API",\n  "main": "server.js",\n  "scripts": {\n    "dev": "NODE_ENV=development nodemon server.js",\n    "start": "NODE_ENV=production node server.js",\n    "test": "NODE_ENV=test jest --detectOpenHandles --forceExit\",\n    "test:watch": "NODE_ENV=test jest --watch\",\n    "test:admin": "NODE_ENV=test jest tests/integration.test.js\"\n  },\n  "jest": {\n    "testEnvironment": "node",\n    "testTimeout": 30000,\n    "verbose": true\n  },\n  "keywords": [\"gaming\", \"marketplace\", \"api\"],\n  "author": "baykayisi",\n  "license": "MIT",\n  "dependencies": {\n    \"express\": \"^4.18.2\",\n    \"mongoose\": \"^7.0.0\",\n    \"bcryptjs\": \"^2.4.3\",\n    \"jsonwebtoken\": \"^9.0.0\",\n    \"cors\": \"^2.8.5\",\n    \"dotenv\": \"^16.0.3\",\n    \"express-validator\": \"^7.0.0\"\n  },\n  \"devDependencies\": {\n    \"nodemon\": \"^2.0.20\",\n    \"jest\": \"^29.0.0\",\n    \"supertest\": \"^6.3.0\"\n  }\n}\n